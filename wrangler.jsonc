// Cloudflare sozlamasi
// - Sayt fayllari shu papkadan beriladi, /api/... so'rovlari worker/index.ts da
// - D1 bazasi: Cloudflare'da "ta-lim-db" nomi bilan yaratiladi, ID shu yerga yoziladi
{
  "name": "ta-lim",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ta-lim-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
